{
  "name": "zorbit",
  "version": "2.0.6",
  "versionCode": 7,
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs",
    "electron:dev": "electron .",
    "electron:dir": "npm run build && electron-builder --win dir",
    "electron:exe": "npm run build && electron-builder --win nsis portable",
    "electron:msix": "powershell -ExecutionPolicy Bypass -File scripts/build-msix.ps1"
  },
  "build": {
    "appId": "com.truncgil.zorbit.game",
    "productName": "Zorbit",
    "directories": {
      "output": "build/electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon-256.png",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "pixi.js": "^8.23.0"
  }
}
